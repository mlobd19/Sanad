# Copier en .env puis remplir. Ne jamais committer le .env.
#
# PRODUCTION PAR DÉFAUT : sans DJANGO_DEBUG=1, Sanad démarre en production et REFUSE de démarrer
# si une variable indispensable manque (config/production.py) : DJANGO_SECRET_KEY, DATABASE_URL
# PostgreSQL, envoi réel des SMS et des e-mails, fournisseur de paiement opérationnel avec son
# secret, ATTESTATION_SIGNING_KEY…
#
# Développement local : garder DJANGO_DEBUG=1.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
# Production : DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/sanad (SQLite refusé)
# DATABASE_URL=

# Démonstration (distinct de DEBUG) : simulateurs de paiement et d'identité, comptes démo,
# commande reset_demo. Ne lève aucune autre protection.
DEMO_MODE=1
# Mot de passe des comptes démo (agents, équipe, entreprise) : à choisir, jamais dans le code.
# En ligne (DEBUG faux) : 12 caractères au moins.
DEMO_PASSWORD=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées pour les formulaires (back-office servi via l'app). En production : https://<domaine>
CSRF_TRUSTED_ORIGINS=http://localhost:3000

PLATFORM_NAME=Sanad

# Pièces NIF / RC et photos de sinistre : dossier privé, jamais servi publiquement. En production :
# disque persistant (les fichiers doivent survivre aux redéploiements).
# PRIVATE_MEDIA_ROOT=/chemin/du/disque/persistant

# Graine Ed25519 en base64 (32 octets). Générer avec :
#   python manage.py shell -c "from apps.attestations.signing import generate_seed_b64; print(generate_seed_b64())"
# En production : coffre de clés, jamais dans le dépôt.
ATTESTATION_SIGNING_KEY=
ATTESTATION_VERIFY_BASE_URL=http://localhost:8000/v/

# Moyens de paiement actifs, séparés par des virgules.
# "simulated" n'est accepté en production qu'avec DEMO_MODE=1, et avec un vrai secret ci-dessous.
PAYMENT_PROVIDERS=simulated
SIMULATED_CALLBACK_SECRET=dev-simulated-secret
BANKILY_CALLBACK_SECRET=
MASRVI_CALLBACK_SECRET=
SEDAD_CALLBACK_SECRET=
# Plafond d'une transaction mobile money en MRU (0 = aucun). À confirmer avec les opérateurs.
PAYMENT_MAX_AMOUNT=0

# Console = développement seulement (refusée en production). Les codes SMS n'y sont en clair qu'en DEBUG.
NOTIFICATION_BACKEND=apps.notifications.backends.ConsoleBackend

# Identité numérique (eID Houwiyeti) vérifiée auprès de l'ANRPTS avec le seul NNI.
# simulated = registre fictif (DEBUG ou DEMO_MODE). Obligatoire en production
# (adaptateur ANRPTS à écrire). Limite : vérifications par compte et par heure.
IDENTITY_PROVIDER=simulated
IDENTITY_THROTTLE_RATE=5/hour

# Lecture de la carte grise (photo -> champs du véhicule) par l'API Claude.
# Clé à créer sur https://platform.claude.com ; vide = lecture désactivée.
# La photo est envoyée à Anthropic puis oubliée : Sanad ne l'enregistre pas.
ANTHROPIC_API_KEY=
REGISTRATION_SCAN_MODEL=claude-opus-5-5
SCAN_THROTTLE_RATE=20/hour

# Limites de débit : nombre de relais de confiance devant Django (hébergeur, Next.js…).
# 0 = X-Forwarded-For ignoré. Mal réglé, un client pourrait falsifier son adresse IP.
# Obligatoire en production (pas de valeur implicite) ; Render : NUM_PROXIES=1.
NUM_PROXIES=0
# Codes SMS par adresse IP et par heure : large, une adresse d'opérateur mobile est partagée.
OTP_THROTTLE_RATE=60/hour
# Codes SMS envoyés à un même numéro par heure (en plus de la limite par adresse IP).
OTP_MAX_SMS_PER_PHONE_PER_HOUR=5

# Comptes professionnels (agents assureurs) : liens d'invitation et de réinitialisation.
PORTAL_BASE_URL=http://localhost:3000
PRO_LOGIN_MAX_FAILURES=5
PRO_LOGIN_LOCK_MINUTES=15
# Back-office : second facteur après le mot de passe.
# totp = application d'authentification (obligatoire en production) ; sms (code dans la console)
# ou off : développement seulement (DJANGO_DEBUG=1).
BACKOFFICE_2FA=totp
# Connexions à l'app : un jeton par appareil, qui expire (particulier : jours ; compte pro : heures).
AUTH_TOKEN_TTL_CUSTOMER_DAYS=30
AUTH_TOKEN_TTL_PRO_HOURS=8

# E-mail : console en développement ; en production, SMTP (console refusée).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Sanad <no-reply@localhost>

# Surveillance des erreurs (Sentry) : vide = désactivée. Aucune donnée personnelle n'est envoyée.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# PDF de l'attestation : mention « SPÉCIMEN » tant qu'aucun partenariat n'est signé.
ATTESTATION_SPECIMEN=true
