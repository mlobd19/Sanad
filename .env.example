# Copier en .env puis remplir. Ne jamais committer le .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées pour les formulaires (back-office servi via l'app). En production : https://<domaine>
CSRF_TRUSTED_ORIGINS=http://localhost:3000

PLATFORM_NAME=Sanad

# Pièces d'identité : dossier privé, jamais servi publiquement. En production :
# disque persistant (les fichiers doivent survivre aux redéploiements).
# PRIVATE_MEDIA_ROOT=/chemin/du/disque/persistant

# Graine Ed25519 en base64 (32 octets). Générer avec :
#   python manage.py shell -c "from apps.attestations.signing import generate_seed_b64; print(generate_seed_b64())"
# En production : coffre de clés, jamais dans le dépôt.
ATTESTATION_SIGNING_KEY=
ATTESTATION_VERIFY_BASE_URL=http://localhost:8000/v/

# Moyens de paiement actifs, séparés par des virgules.
# "simulated" est refusé quand DJANGO_DEBUG=false.
PAYMENT_PROVIDERS=simulated
SIMULATED_CALLBACK_SECRET=dev-simulated-secret
BANKILY_CALLBACK_SECRET=
MASRVI_CALLBACK_SECRET=
SEDAD_CALLBACK_SECRET=
# Plafond d'une transaction mobile money en MRU (0 = aucun). À confirmer avec les opérateurs.
PAYMENT_MAX_AMOUNT=0

NOTIFICATION_BACKEND=apps.notifications.backends.ConsoleBackend

# Vérification d'identité au registre national (ANRPTS).
# simulated = registre fictif (interdit hors DEBUG) ; vide = désactivée.
IDENTITY_PROVIDER=simulated
IDENTITY_THROTTLE_RATE=5/hour

# Lecture de la carte grise (photo -> champs du véhicule) par l'API Claude.
# Clé à créer sur https://platform.claude.com ; vide = lecture désactivée.
# La photo est envoyée à Anthropic puis oubliée : Sanad ne l'enregistre pas.
ANTHROPIC_API_KEY=
REGISTRATION_SCAN_MODEL=claude-opus-5-5
SCAN_THROTTLE_RATE=20/hour

# Comptes professionnels (agents assureurs) : liens d'invitation et de réinitialisation.
PORTAL_BASE_URL=http://localhost:3000
PRO_LOGIN_MAX_FAILURES=5
PRO_LOGIN_LOCK_MINUTES=15
# Back-office : code SMS après le mot de passe (obligatoire en production ; False possible en développement).
BACKOFFICE_SMS_CODE=True

# E-mail : console en développement ; en production, SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Sanad <no-reply@localhost>

# PDF de l'attestation : mention « SPÉCIMEN » tant qu'aucun partenariat n'est signé.
ATTESTATION_SPECIMEN=true
